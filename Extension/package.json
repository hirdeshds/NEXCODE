{
  "name": "nexcode-ai-studio-pro",
  "displayName": "NexCode AI Studio Pro",
  "description": "AI coding helper that connects VS Code to the NexCode backend.",
  "version": "0.0.3",
  "keywords": [
    "ai",
    "coding",
    "assistant",
    "productivity",
    "github",
    "chat"
  ],
  "license": "Apache-2.0",
  "publisher": "hirdeshds",
  "repository": {
    "type": "git",
    "url": "https://github.com/hirdeshds/nexcode"
  },
  "homepage": "https://github.com/hirdeshds/nexcode",
  "bugs": {
    "url": "https://github.com/hirdeshds/nexcode/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nexcode-sidebar-container",
          "title": "NexCode",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "nexcode-sidebar-container": [
        {
          "type": "webview",
          "id": "nexcode-sidebar-view",
          "name": "NexCode",
          "icon": "media/icon.png"
        }
      ]
    },
    "configuration": {
      "title": "NexCode",
      "properties": {
        "nexcode.backendUrl": {
          "type": "string",
          "default": "https://nexcode-3n9e.onrender.com",
          "description": "Base URL of the NexCode FastAPI backend."
        },
        "nexcode.enableInlineCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Enable NexCode inline code completions."
        }
      }
    },
    "commands": [
      {
        "command": "nexcode.explainCode",
        "title": "NexCode: Explain Code"
      },
      {
        "command": "nexcode.fixCode",
        "title": "NexCode: Fix Code"
      },
      {
        "command": "nexcode.generateCode",
        "title": "NexCode: Generate Code"
      },
      {
        "command": "nexcode.generateProject",
        "title": "NexCode: Generate Project"
      },
      {
        "command": "nexcode.reviewCode",
        "title": "NexCode: Review Code"
      },
      {
        "command": "nexcode.runPipeline",
        "title": "NexCode: Run Pipeline Scan"
      },
      {
        "command": "nexcode.deployToVercel",
        "title": "NexCode: Deploy to Vercel"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "nexcode.explainCode",
          "group": "navigation@10"
        },
        {
          "command": "nexcode.fixCode",
          "group": "navigation@11"
        },
        {
          "command": "nexcode.reviewCode",
          "group": "navigation@12"
        }
      ],
      "commandPalette": [
        {
          "command": "nexcode.explainCode"
        },
        {
          "command": "nexcode.fixCode"
        },
        {
          "command": "nexcode.generateCode"
        },
        {
          "command": "nexcode.generateProject"
        },
        {
          "command": "nexcode.reviewCode"
        },
        {
          "command": "nexcode.runPipeline"
        },
        {
          "command": "nexcode.deployToVercel"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nexcode.deployToVercel",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "editorTextFocus"
      },
      {
        "command": "nexcode.explainCode",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorTextFocus"
      },
      {
        "command": "nexcode.fixCode",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "editorTextFocus"
      },
      {
        "command": "nexcode.reviewCode",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorTextFocus"
      },
      {
        "command": "nexcode.generateCode",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "editorTextFocus"
      },
      {
        "command": "nexcode.runPipeline",
        "key": "ctrl+shift+p",
        "mac": "cmd+shift+p",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ --noEmit",
    "watch": "tsc -watch -p ./",
    "bundle": "webpack --config webpack.config.js",
    "package": "npm run bundle && vsce package --allow-missing-repository",
    "publish": "npm run bundle && vsce publish --allow-missing-repository",
    "vscode:prepublish": "npm run bundle",
    "prepackage": "npm run bundle"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  }
}
